# --- Sistem Operasi ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
*.cab
*.msi
*.msm
*.msp
desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# --- Editor & IDE ---
# VS Code
.vscode/
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, dll)
.idea/
*.iws
out/

# --- Docker & Environment Variables ---
# Berkas env yang mungkin berisi password cmkadmin atau kredensial lain
.env
.env.*
!.env.example

# Berkas docker-compose lokal/override yang tidak ingin diunggah ke publik
docker-compose.override.yml
docker-compose-local.yml

